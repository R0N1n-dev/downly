<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/qa_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/qa_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#8C000000"/>

    <LinearLayout
        android:id="@+id/qa_sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/qa_sheet"
        android:clickable="true"
        android:orientation="vertical"
        android:paddingLeft="20dp"
        android:paddingTop="10dp"
        android:paddingRight="20dp"
        android:paddingBottom="16dp">

        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="14dp"
            android:background="@drawable/qa_grip"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@mipmap/ic_launcher"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="12dp"
                android:fontFamily="sans-serif-medium"
                android:text="Add download"
                android:textColor="@color/qa_ink"
                android:textSize="22sp"/>
        </LinearLayout>

        <EditText
            android:id="@+id/qa_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/qa_input"
            android:hint="Paste a link or magnet"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="3"
            android:minHeight="52dp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:textColor="@color/qa_ink"
            android:textColorHint="@color/qa_muted"
            android:textSize="15sp"/>

        <TextView
            android:id="@+id/qa_detect"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="@color/qa_muted"
            android:textSize="14sp"/>

        <LinearLayout
            android:id="@+id/qa_options"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <TextView
            android:id="@+id/qa_dest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/qa_muted"
            android:textSize="13sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/qa_open"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_marginRight="10dp"
                android:layout_weight="1"
                android:background="@drawable/qa_btn_soft"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Open app"
                android:textColor="@color/qa_ink"
                android:textSize="15sp"/>

            <TextView
                android:id="@+id/qa_go"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="2"
                android:background="@drawable/qa_btn_primary"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:text="Download"
                android:textColor="@color/qa_on_cta"
                android:textSize="16sp"/>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
